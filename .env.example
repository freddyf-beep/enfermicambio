SUPABASE_URL=
SUPABASE_ANON_KEY=
COMPETITION_TZ=America/Santiago
# Optional Firebase client configuration for real Android/iPhone push.
# These values are public app configuration, not service-account secrets.
FIREBASE_API_KEY=
FIREBASE_APP_ID_ANDROID=
FIREBASE_APP_ID_IOS=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_IOS_BUNDLE_ID=com.enfermicambio.enfermicambio
# Keep false until the feature repositories and AuthGate are migrated from
# Supabase to Firestore. Firebase initialization and FCM work independently.
FIREBASE_AUTH_ENABLED=false
