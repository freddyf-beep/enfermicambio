<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSHealthShareUsageDescription</key>
	<string>Enfermicambio lee pasos, calorías, distancia, entrenamientos y rutas para mostrar tu actividad y calcular el ranking privado.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>Enfermicambio no escribe datos en Apple Health.</string>
	<key>NSMotionUsageDescription</key>
	<string>Enfermicambio usa movimiento y actividad física para detectar y validar tu entrenamiento.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Enfermicambio usa tu ubicación precisa mientras entrenas para registrar y mostrar la ruta recorrida.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Enfermicambio mantiene el GPS activo durante una carrera, caminata o salida en bicicleta, incluso si bloqueas la pantalla, para no cortar tu ruta.</string>
	<key>io.flutter.embedded_views_preview</key>
	<true/>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Enfermicambio usa Bluetooth para encontrar y conectar sensores deportivos, como pulsómetros y accesorios de actividad.</string>
	<key>NSCameraUsageDescription</key>
	<string>Enfermicambio usa la cámara para escanear códigos de barras y registrar fotos de comida.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Enfermicambio accede a tus fotos para registrar comidas y compartirlas en el grupo.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Enfermicambio puede guardar fotos de comida en tu biblioteca cuando lo indiques.</string>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Enfermicambio</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>enfermicambio</string>
	<key>CFBundleIcons</key>
	<dict>
		<key>CFBundleAlternateIcons</key>
		<dict>
			<key>AppIconRedTransparent</key>
			<dict>
				<key>CFBundleIconFiles</key>
				<array><string>AppIconRedTransparent</string></array>
			</dict>
			<key>AppIconRedCropped</key>
			<dict>
				<key>CFBundleIconFiles</key>
				<array><string>AppIconRedCropped</string></array>
			</dict>
			<key>AppIconMedicalCropped</key>
			<dict>
				<key>CFBundleIconFiles</key>
				<array><string>AppIconMedicalCropped</string></array>
			</dict>
		</dict>
	</dict>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>com.HealthExport</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
